---
// Page section components
import ContactCTA from '../components/sections/ContactCTA.astro';
import Hero from '../components/sections/Hero.astro';
import Icon from '../components/ui/Icon.astro';

import About from '../components/sections/About.astro';
import Works from '../components/sections/Works.astro';
import Articles from '../components/sections/Articles.astro';
import BaseLayout from '../layouts/BaseLayout.astro';


import type { iconPaths } from '../components/ui/IconPaths';


const iconLinks: { label: string; href: string; icon: keyof typeof iconPaths }[] = [
  { label: 'GitHub', href: 'https://github.com/irohamo', icon: 'github-logo' },
  { label: 'Instagram', href: 'https://Instagram.com/irohamo.dev', icon: 'instagram-logo' },
];

// Full Astro Component Syntax:
// https://docs.astro.build/basics/astro-components/
---

<BaseLayout>
	<div class="stack gap-15 lg:gap-20">
		<div class="wrapper stack gap-8 lg:gap-15">
			<header class="hero">
				<Hero
					title="irohamo"
					tagline="アプリをつくり、三味線を弾いています。"
					align="start"
				>
					<div class="roles">
						<span class="role">Developer</span>
						<span class="role-sep" aria-hidden="true">/</span>
						<span class="role">Shamisen</span>
					</div>
					<div class="socials">
						{iconLinks.map(({ href, icon, label }) => (
							<a href={href} class="social" target="_blank" rel="noopener noreferrer">
								<span class="sr-only">{label}</span>
								<Icon icon={icon} />
							</a>
						))}
					</div>
				</Hero>
			</header>
			<About />
		</div>

		<main class="wrapper stack gap-15 lg:gap-20">
            <Works />
            <Articles />
		</main>
		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.roles {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: baseline;
		gap: 0.6rem;
		font-family: var(--font-brand);
		font-size: var(--text-md);
		letter-spacing: 0.02em;
		color: var(--gray-200);
	}

	.role-sep {
		color: var(--gray-500);
	}

	.socials {
		display: flex;
		justify-content: center;
		gap: 0.25rem;
	}

	.social {
		display: flex;
		padding: 0.5rem;
		color: var(--gray-400);
		text-decoration: none;
		transition: color var(--theme-transition);
	}

	.social:hover {
		color: var(--gray-0);
	}

	@media (min-width: 50em) {
		.hero {
			padding-inline: 2.5rem;
			align-items: flex-start;
		}

		.roles {
			justify-content: flex-start;
		}

		.socials {
			justify-content: flex-start;
			margin-top: -0.25rem;
			margin-inline: -0.5rem;
		}
	}

	.section {
		display: grid;
		gap: 2rem;
	}

	.section.with-background {
		border-top: 1px solid var(--gray-800);
		padding-top: 2.5rem;
	}

	.section-header {
		justify-self: center;
		text-align: center;
		max-width: 50ch;
		font-size: var(--text-md);
		color: var(--gray-0);
	}

	.section-header h3 {
		font-size: var(--text-2xl);
	}

	@media (min-width: 50em) {
		.section {
			grid-template-columns: repeat(4, 1fr);
			grid-template-areas: 'header header header header' 'gallery gallery gallery gallery';
			gap: 2.5rem;
		}

		.section.with-cta {
			grid-template-areas: 'header header header cta' 'gallery gallery gallery gallery';
		}

		.section-header {
			grid-area: header;
			font-size: var(--text-lg);
		}

		.section-header h3 {
			font-size: var(--text-4xl);
		}

		.with-cta .section-header {
			justify-self: flex-start;
			text-align: left;
		}

		.gallery {
			grid-area: gallery;
		}

		.cta {
			grid-area: cta;
		}
	}
	.mention-embed {
		max-width: 48rem;
		width: 100%;
		justify-self: center;
	}
</style>
