---
import Grid from '../ui/Grid.astro';
import PortfolioPreview from '../cards/PortfolioPreview.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('works'))
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const featuredProjects = projects.slice(0, 4);
---

<section class="section with-background with-cta">
	<header class="section-header stack gap-2 lg:gap-4">
		<p class="eyebrow">Portfolio</p>
		<h3>Works</h3>
	</header>

	<div class="gallery">
		<Grid>
			{
				featuredProjects.map((project) => (
					<li>
						<PortfolioPreview project={project} />
					</li>
				))
			}
		</Grid>
	</div>

	{
		projects.length > 4 && (
			<footer class="works-footer">
				<a href="/works" class="works-link">
					すべて見る<span aria-hidden="true">→</span>
				</a>
			</footer>
		)
	}
</section>

<style>
	.works-footer {
		display: flex;
		justify-content: flex-end;
		margin-top: 1.25rem;
	}

	.works-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		padding: 0.25rem 0;
		color: var(--gray-0);
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		font-weight: 500;
		letter-spacing: 0.02em;
		text-decoration: none;
		border-bottom: 1px solid var(--gray-300);
		transition:
			color var(--theme-transition),
			border-color var(--theme-transition);
	}

	.works-link span {
		transition: transform var(--theme-transition);
	}

	.works-link:hover,
	.works-link:focus-visible {
		color: var(--accent-regular);
		border-color: var(--accent-regular);
	}

	.works-link:hover span,
	.works-link:focus-visible span {
		transform: translateX(3px);
	}
</style>